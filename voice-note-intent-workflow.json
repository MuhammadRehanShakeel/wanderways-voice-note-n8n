{
  "name": "Voice Note Intent Classifier",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-note",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 300],
      "webhookId": "a1000000-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'llama-3.1-8b-instant',\n  temperature: 0,\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: 'You classify a transcribed voice note. Reply with JSON only, no extra text, in exactly this shape: {\"intent\":\"...\",\"details\":{}}. intent is one short snake_case label such as flight_query, reminder, note, complaint, other. details holds any useful fields you can extract (destination, date, person, amount). If nothing is extractable, details is an empty object.' },\n    { role: 'user', content: $json.body.text }\n  ]\n}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Classify with Groq",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [20, 300],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "GROQ_HEADER_AUTH",
          "name": "Groq API Key (Header Auth)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Groq ka reply JSON string hota hai -> usko parse karo\nconst raw = $json.choices?.[0]?.message?.content;\nif (!raw) {\n  throw new Error('LLM returned no content');\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  throw new Error('LLM did not return valid JSON: ' + raw);\n}\n\nif (!parsed.intent) {\n  throw new Error('LLM JSON has no \"intent\" field: ' + raw);\n}\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    text: $('Webhook').first().json.body.text,\n    intent: JSON.stringify(parsed)\n  }\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Parse Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Results",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $json.timestamp }}",
            "text": "={{ $json.text }}",
            "intent": "={{ $json.intent }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Log to Results Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, 300],
      "onError": "continueErrorOutput",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_OAUTH",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'ok', intent: JSON.parse($json.intent) }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "jsCode": "// Error branch: jo bhi node fail hua, uska message yahan aata hai\nconst err = $json.error;\nconst message = (typeof err === 'string' ? err : err?.message) || $json.message || 'Unknown error';\n\nlet originalText = '';\ntry {\n  originalText = $('Webhook').first().json.body?.text || '';\n} catch (e) {\n  originalText = '';\n}\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    text: originalText,\n    error: String(message).slice(0, 500)\n  }\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Build Error Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 540]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Errors",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $json.timestamp }}",
            "text": "={{ $json.text }}",
            "error": "={{ $json.error }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Log to Errors Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, 540],
      "onError": "continueRegularOutput",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_OAUTH",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'error', error: $json.error }) }}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Respond 500",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [700, 540]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
